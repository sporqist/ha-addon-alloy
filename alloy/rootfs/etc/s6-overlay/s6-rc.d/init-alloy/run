#!/usr/bin/with-contenv bash
# Generates /etc/alloy/config.alloy from the add-on options, then validates it.
#
# DEFAULTS ARE FAITHFUL AND MINIMAL. The journal is shipped as journald recorded
# it: job "systemd-journal", stream labels hostname/unit/level, level = the
# journal priority. Every transformation (a different job, more labels, a level
# re-derived from the message, extra journal fields as structured metadata)
# is an option that defaults off: a Loki without structured metadata enabled
# rejects the whole push, and more stream labels are a stranger's cardinality.
set -e

CONFIG_DIR="/etc/alloy"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OPTIONS_FILE="/data/options.json"

mkdir -p "${CONFIG_DIR}" /data/alloy

opt() { jq -r "$1" "${OPTIONS_FILE}"; }
LOKI_URL=$(opt '.loki_url')
LOG_LEVEL=$(opt '.log_level // "info"')
JOB=$(opt '.job // "systemd-journal"')
STREAM_LABELS=$(opt '(.stream_labels // ["hostname","unit","level"]) | join(" ")')
STRUCTURED_METADATA=$(opt '.structured_metadata // false')
LEVEL_FROM_MESSAGE=$(opt '.level_from_message // false')
METRICS_ENABLED=$(opt '.metrics_enabled // false')
ADDITIONAL_CONFIG=$(opt '.additional_config // ""')

has_label() { case " ${STREAM_LABELS} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Detect the journal path: the directory holding the NEWEST journal file,
# which is where journald is writing now. "First non-empty directory" chose
# /var/log/journal on a host whose journald had gone volatile, leaving stale
# files there and every live entry in /run/log/journal - and Alloy then
# shipped nothing, silently. HA OS is persistent, so both agree there.
JOURNAL_PATH="/var/log/journal"
newest=$(find /var/log/journal /run/log/journal -type f -name '*.journal' -printf '%T@ %h\n' 2>/dev/null \
         | sort -n | tail -1 | cut -d' ' -f2-)
if [ -n "${newest}" ]; then
    case "${newest}" in
        /run/log/journal*) JOURNAL_PATH="/run/log/journal" ;;
        *)                 JOURNAL_PATH="/var/log/journal" ;;
    esac
elif [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    JOURNAL_PATH="/run/log/journal"
fi

echo "-----------------------------------------------------------"
echo " Grafana Alloy for Home Assistant"
echo " Loki URL: ${LOKI_URL}"
echo " Journal path: ${JOURNAL_PATH}"
echo " Log level: ${LOG_LEVEL}"
echo " job: ${JOB}   stream labels: ${STREAM_LABELS}"
echo " structured metadata: ${STRUCTURED_METADATA}   level from message: ${LEVEL_FROM_MESSAGE}"
echo "-----------------------------------------------------------"

# ── Source and stream labels ────────────────────────────────────────────────
cat > "${CONFIG_FILE}" <<EOF
// Grafana Alloy config - generated by the Home Assistant add-on from its options.
// Do not edit; change the options instead.

logging {
  level = "${LOG_LEVEL}"
}

// The journal, as JSON so every field is available to the pipeline below.
loki.source.journal "journal" {
  path           = "${JOURNAL_PATH}"
  format_as_json = true
  forward_to     = [loki.process.journal.receiver]
  relabel_rules  = loki.relabel.journal.rules
  labels         = {
    job = "${JOB}",
  }
}

// Stream labels: only the ones chosen in stream_labels.
loki.relabel "journal" {
  forward_to = []
EOF

relabel() { printf '  rule {\n    source_labels = ["%s"]\n    target_label  = "%s"\n  }\n' "$1" "$2" >> "${CONFIG_FILE}"; }
has_label hostname          && relabel __journal__hostname        hostname
has_label unit              && relabel __journal__systemd_unit    unit
has_label level             && relabel __journal_priority_keyword level
has_label syslog_identifier && relabel __journal_syslog_identifier syslog_identifier
has_label container_name    && relabel __journal_container_name   container_name
has_label transport         && relabel __journal__transport       transport
has_label priority          && relabel __journal_priority         priority
# level_from_message needs to know which streams are containers, whether or not
# container_name was chosen as a label; a temporary label is dropped again below.
if [ "${LEVEL_FROM_MESSAGE}" = "true" ]; then
    has_label level          || relabel __journal_priority_keyword level
    has_label container_name || relabel __journal_container_name   container_name
fi
echo "}" >> "${CONFIG_FILE}"

# ── Pipeline ────────────────────────────────────────────────────────────────
cat >> "${CONFIG_FILE}" <<'EOF'

loki.process "journal" {
  // Pull the fields the options refer to out of the JSON entry.
  stage.json {
    expressions = {
      message           = "MESSAGE",
      syslog_identifier = "SYSLOG_IDENTIFIER",
      container_name    = "CONTAINER_NAME",
      transport         = "_TRANSPORT",
      priority          = "PRIORITY",
    }
  }
EOF

if [ "${STRUCTURED_METADATA}" = "true" ]; then
    # One home per field: what is already a stream label is not also metadata.
    # Loki keeps a name in one place, and a duplicate would be the label lost.
    sm=""
    for f in syslog_identifier container_name transport priority; do
        has_label "$f" || sm="${sm}      ${f} = \"\",\n"
    done
    if [ -n "${sm}" ]; then
        printf '\n  // Detail that is useful per line but poison as a stream label.\n  stage.structured_metadata {\n    values = {\n%b    }\n  }\n' "${sm}" >> "${CONFIG_FILE}"
    fi
fi

if [ "${LEVEL_FROM_MESSAGE}" = "true" ]; then
cat >> "${CONFIG_FILE}" <<'EOF'

  // Docker's journald driver logs a container's stderr at priority err, so a
  // WARN or INFO line written to stderr arrives as level="error". Scoped to
  // container streams at that priority; the level is re-derived from the line
  // (logfmt level=..., or a bare LEVEL token) and falls back to "error".
  stage.match {
    selector = "{level=\"error\", container_name=~\".+\"}"

    stage.regex {
      expression = "(?:^|\\s)level=(?P<logfmt_level>trace|debug|info|warn|warning|error|fatal|critical)(?:\\s|$)"
    }
    stage.regex {
      expression = "(?:^|\\s)(?P<bare_level>TRACE|DEBUG|INFO|WARN|WARNING|ERROR|FATAL|CRITICAL)(?:\\s|:)"
    }
    stage.template {
      source   = "derived_level"
      template = "{{ if .logfmt_level }}{{ if eq .logfmt_level \"warn\" }}warning{{ else if eq .logfmt_level \"critical\" }}crit{{ else }}{{ .logfmt_level }}{{ end }}{{ else if .bare_level }}{{ if eq .bare_level \"TRACE\" }}trace{{ else if eq .bare_level \"DEBUG\" }}debug{{ else if eq .bare_level \"INFO\" }}info{{ else if eq .bare_level \"WARN\" }}warning{{ else if eq .bare_level \"WARNING\" }}warning{{ else if eq .bare_level \"ERROR\" }}error{{ else if eq .bare_level \"FATAL\" }}fatal{{ else if eq .bare_level \"CRITICAL\" }}crit{{ else }}error{{ end }}{{ else }}error{{ end }}"
    }
    stage.labels {
      values = {
        level = "derived_level",
      }
    }
  }
EOF
    drop=""
    has_label container_name || drop="${drop}\"container_name\", "
    has_label level          || drop="${drop}\"level\", "
    if [ -n "${drop}" ]; then
        printf '\n  // Temporary labels level_from_message needed, not chosen in stream_labels.\n  stage.label_drop {\n    values = [%s]\n  }\n' "${drop%, }" >> "${CONFIG_FILE}"
    fi
fi

cat >> "${CONFIG_FILE}" <<EOF

  // The line itself is the journal MESSAGE again, not the JSON entry.
  stage.output {
    source = "message"
  }
  stage.drop {
    expression = "^\\\\s*$"
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "${LOKI_URL}"
  }
}
EOF

# ── Home Assistant metrics (opt-in) ─────────────────────────────────────────
# Scrapes an OpenMetrics endpoint - by default Home Assistant's own
# /api/prometheus, which needs `prometheus:` in configuration.yaml - and
# remote-writes it. Off: nothing below is read and the config above is all
# there is. The token never enters the config file: it is written to a 0600
# file and referenced, so the config stays readable without the secret.
TOKEN_FILE="/data/metrics.token"
if [ "${METRICS_ENABLED}" = "true" ]; then
    METRICS_URL=$(opt '.metrics_url // "http://homeassistant:8123/api/prometheus"')
    METRICS_TOKEN=$(opt '.metrics_token // ""')
    METRICS_REMOTE_WRITE_URL=$(opt '.metrics_remote_write_url // ""')
    METRICS_INTERVAL=$(opt '.metrics_interval // "60s"')
    METRICS_JOB=$(opt '.metrics_job // "homeassistant"')
    RW_USER=$(opt '.metrics_remote_write_user // ""')
    RW_PASSWORD=$(opt '.metrics_remote_write_password // ""')
    if [ -z "${METRICS_REMOTE_WRITE_URL}" ] || [ "${METRICS_REMOTE_WRITE_URL}" = "null" ]; then
        echo "!! metrics_enabled is on but metrics_remote_write_url is empty - nowhere to send the metrics."
        exit 1
    fi
    # Split the URL into what prometheus.scrape wants: scheme, host:port, path.
    scheme="${METRICS_URL%%://*}"
    rest="${METRICS_URL#*://}"
    hostport="${rest%%/*}"
    path="/${rest#*/}"; [ "${path}" = "/${rest}" ] && path="/metrics"
    case "${scheme}" in http|https) ;; *) echo "!! metrics_url must start with http:// or https://"; exit 1 ;; esac
    # Alloy refuses a scrape_timeout above the interval, and `alloy validate`
    # does not see that (it is a component build error, so the service would
    # crash-loop). Timeout = half the interval, capped at Alloy's 10s default.
    n="${METRICS_INTERVAL%[smh]}"; u="${METRICS_INTERVAL##*[0-9]}"
    METRICS_TIMEOUT="10s"
    if [ "${u}" = "s" ] && [ "${n}" -le 20 ] 2>/dev/null; then
        t=$(( n / 2 )); [ "${t}" -lt 1 ] && t=1
        METRICS_TIMEOUT="${t}s"
    fi

    auth=""
    if [ -n "${METRICS_TOKEN}" ] && [ "${METRICS_TOKEN}" != "null" ]; then
        # printf, not echo: a trailing newline would go out as "Bearer xxx\n".
        (umask 077; printf '%s' "${METRICS_TOKEN}" > "${TOKEN_FILE}")
        auth="  bearer_token_file = \"${TOKEN_FILE}\""
    else
        rm -f "${TOKEN_FILE}"
    fi
    # Hosted Prometheus (Grafana Cloud and the like) wants basic auth on the
    # remote_write. Password via a 0600 file, like the token, so it is not in
    # the config. Rendered only when a user is set.
    RW_PASSWORD_FILE="/data/remote_write.password"
    rw_auth=""
    if [ -n "${RW_USER}" ] && [ "${RW_USER}" != "null" ]; then
        (umask 077; printf '%s' "${RW_PASSWORD}" > "${RW_PASSWORD_FILE}")
        rw_auth="    basic_auth {
      username      = \"${RW_USER}\"
      password_file = \"${RW_PASSWORD_FILE}\"
    }"
    else
        rm -f "${RW_PASSWORD_FILE}"
    fi
    echo " metrics: ${scheme}://${hostport}${path} every ${METRICS_INTERVAL} as job ${METRICS_JOB} -> ${METRICS_REMOTE_WRITE_URL} (token: $([ -n "${auth}" ] && echo set || echo none); remote_write auth: $([ -n "${rw_auth}" ] && echo basic || echo none))"

    cat >> "${CONFIG_FILE}" <<EOF

// --- Home Assistant metrics (metrics_enabled) ---
prometheus.scrape "metrics" {
  targets = [{
    __address__ = "${hostport}",
    instance    = "$(hostname)",
  }]
  scheme          = "${scheme}"
  metrics_path    = "${path}"
  job_name        = "${METRICS_JOB}"
  scrape_interval = "${METRICS_INTERVAL}"
  scrape_timeout  = "${METRICS_TIMEOUT}"
${auth}
  forward_to = [prometheus.remote_write.metrics.receiver]
}

prometheus.remote_write "metrics" {
  endpoint {
    url = "${METRICS_REMOTE_WRITE_URL}"
${rw_auth}
  }
}
EOF
else
    rm -f "${TOKEN_FILE}" /data/remote_write.password
fi

if [ -n "${ADDITIONAL_CONFIG}" ] && [ "${ADDITIONAL_CONFIG}" != "null" ]; then
    printf '\n// --- Additional user config ---\n%s\n' "${ADDITIONAL_CONFIG}" >> "${CONFIG_FILE}"
fi

echo "Alloy config generated at ${CONFIG_FILE}"

# Fail fast, with the parser's message, rather than let the service crash-loop
# on a bad additional_config where nobody is watching. s6 stops the container
# when this oneshot exits non-zero, and the add-on log says why.
if ! /usr/bin/alloy validate "${CONFIG_FILE}"; then
    echo "!! the generated Alloy config is invalid - see above. Check loki_url and additional_config."
    exit 1
fi
echo "Alloy config validated"
