#!/usr/bin/with-contenv bash
# Generates /etc/alloy/config.alloy from the add-on options, then validates it.
#
# DEFAULTS ARE FAITHFUL AND MINIMAL. The journal is shipped as journald recorded
# it: job "systemd-journal", stream labels hostname/unit/level, level = the
# journal priority. Every transformation (a different job, more labels, a level
# re-derived from the message, extra journal fields as structured metadata)
# is an option that defaults off: a Loki without structured metadata enabled
# rejects the whole push, and more stream labels are a stranger's cardinality.
set -e

CONFIG_DIR="/etc/alloy"
CONFIG_FILE="${CONFIG_DIR}/config.alloy"
OPTIONS_FILE="/data/options.json"

mkdir -p "${CONFIG_DIR}" /data/alloy

opt() { jq -r "$1" "${OPTIONS_FILE}"; }
# optd <key> <default>: an option that is absent OR an empty string means the
# default. Every optional key is listed in config.yaml's options with "" so the
# form shows it; jq's // would treat that "" as a value.
optd() { jq -r --arg d "$2" ".$1 | if . == null or . == \"\" then \$d else . end" "${OPTIONS_FILE}"; }
LOKI_URL=$(opt '.loki_url')
LOG_LEVEL=$(optd log_level info)
JOB=$(optd job systemd-journal)
STREAM_LABELS=$(opt '(.stream_labels // ["hostname","unit","level"]) | join(" ")')
STRUCTURED_METADATA=$(opt '.structured_metadata // false')
LEVEL_FROM_MESSAGE=$(opt '.level_from_message // false')
METRICS_ENABLED=$(opt '.metrics_enabled // false')
ADDITIONAL_CONFIG=$(opt '.additional_config // ""')

has_label() { case " ${STREAM_LABELS} " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# The JSON path (every field of the entry available to the pipeline) exists
# for structured_metadata and costs a parse and a restore per line. Only then.
USE_JSON=false
[ "${STRUCTURED_METADATA}" = "true" ] && USE_JSON=true

# Detect the journal path: the directory holding the NEWEST journal file,
# which is where journald is writing now. "First non-empty directory" chose
# /var/log/journal on a host whose journald had gone volatile, leaving stale
# files there and every live entry in /run/log/journal - and Alloy then
# shipped nothing, silently. HA OS is persistent, so both agree there.
JOURNAL_PATH="/var/log/journal"
newest=$(find /var/log/journal /run/log/journal -type f -name '*.journal' -printf '%T@ %h\n' 2>/dev/null \
         | sort -n | tail -1 | cut -d' ' -f2-)
if [ -n "${newest}" ]; then
    case "${newest}" in
        /run/log/journal*) JOURNAL_PATH="/run/log/journal" ;;
        *)                 JOURNAL_PATH="/var/log/journal" ;;
    esac
elif [ ! -d "${JOURNAL_PATH}" ] || [ -z "$(ls -A "${JOURNAL_PATH}" 2>/dev/null)" ]; then
    JOURNAL_PATH="/run/log/journal"
fi

# The image marks its variant: the base has no /etc/alloy-addon/variant, the
# alloy-host image (FROM the base) writes "host" there. Same generator, one
# extra exporter for that variant.
VARIANT=$(cat /etc/alloy-addon/variant 2>/dev/null || echo base)
HOST_METRICS=false
if [ "${VARIANT}" = "host" ]; then
    HOST_METRICS=$(opt '.host_metrics // true')
fi

# finish: validate the generated file and stop the container on failure.
# Fail fast, with the parser's message, rather than let the service crash-loop
# on a bad additional_config where nobody is watching. s6 stops the container
# when this oneshot exits non-zero, and the add-on log says why. This is
# PARSE-level: a config that parses but cannot build (a scrape_timeout above
# its interval, say) passes here and fails at start - the health check is
# the net for that layer.
finish() {
    echo "Alloy config generated at ${CONFIG_FILE}"
    if ! /usr/bin/alloy validate "${CONFIG_FILE}"; then
        echo "!! the generated Alloy config is invalid - see above. Check loki_url and additional_config."
        exit 1
    fi
    echo "Alloy config validated"
}

# ── raw_config: the expert's exit ───────────────────────────────────────────
# Nothing generated but the logging block; additional_config IS the config.
# For people who want their own source.journal, relabel and write with their
# own field and label names, without a knob per label in this add-on. Every
# other option is ignored in this mode, and the file says so.
RAW_CONFIG=$(opt '.raw_config // false')
if [ "${RAW_CONFIG}" = "true" ]; then
    if [ -z "${ADDITIONAL_CONFIG}" ] || [ "${ADDITIONAL_CONFIG}" = "null" ]; then
        echo "!! raw_config is on but additional_config is empty - there is nothing to run."
        exit 1
    fi
    echo "-----------------------------------------------------------"
    echo " Grafana Alloy for Home Assistant (${VARIANT}) - RAW CONFIG"
    echo " additional_config is the whole configuration; every other option is ignored."
    echo " Log level: ${LOG_LEVEL}"
    echo "-----------------------------------------------------------"
    rm -f /data/metrics.token /data/remote_write.password
    cat > "${CONFIG_FILE}" <<EOF
// Grafana Alloy config - raw_config mode: the add-on generated only the
// logging block below; everything else is additional_config, verbatim.
// loki_url, stream_labels, metrics_* and the rest of the options are ignored.

logging {
  level = "${LOG_LEVEL}"
}

EOF
    printf '%s\n' "${ADDITIONAL_CONFIG}" >> "${CONFIG_FILE}"
    finish
    exit 0
fi

echo "-----------------------------------------------------------"
echo " Grafana Alloy for Home Assistant (${VARIANT})"
echo " Loki URL: ${LOKI_URL}"
echo " Journal path: ${JOURNAL_PATH}"
echo " Log level: ${LOG_LEVEL}"
echo " job: ${JOB}   stream labels: ${STREAM_LABELS}"
echo " structured metadata: ${STRUCTURED_METADATA}   level from message: ${LEVEL_FROM_MESSAGE}"
echo "-----------------------------------------------------------"

# ── Source and stream labels ────────────────────────────────────────────────
cat > "${CONFIG_FILE}" <<EOF
// Grafana Alloy config - generated by the Home Assistant add-on from its options.
// Do not edit; change the options instead.

logging {
  level = "${LOG_LEVEL}"
}

// As JSON only when structured_metadata needs the extra fields; otherwise the
// line is the MESSAGE and nothing has to parse or restore it.
loki.source.journal "journal" {
  path           = "${JOURNAL_PATH}"
  format_as_json = ${USE_JSON}
  forward_to     = [loki.process.journal.receiver]
  relabel_rules  = loki.relabel.journal.rules
  labels         = {
    job = "${JOB}",
  }
}

// Stream labels: only the ones chosen in stream_labels.
loki.relabel "journal" {
  forward_to = []
EOF

relabel() { printf '  rule {\n    source_labels = ["%s"]\n    target_label  = "%s"\n  }\n' "$1" "$2" >> "${CONFIG_FILE}"; }
has_label hostname          && relabel __journal__hostname        hostname
has_label unit              && relabel __journal__systemd_unit    unit
has_label level             && relabel __journal_priority_keyword level
has_label syslog_identifier && relabel __journal_syslog_identifier syslog_identifier
has_label container_name    && relabel __journal_container_name   container_name
has_label transport         && relabel __journal__transport       transport
has_label priority          && relabel __journal_priority         priority
# level_from_message needs to know which streams are containers, whether or not
# container_name was chosen as a label; a temporary label is dropped again below.
if [ "${LEVEL_FROM_MESSAGE}" = "true" ]; then
    has_label level          || relabel __journal_priority_keyword level
    has_label container_name || relabel __journal_container_name   container_name
fi
echo "}" >> "${CONFIG_FILE}"

# ── Pipeline ────────────────────────────────────────────────────────────────
printf '\nloki.process "journal" {\n' >> "${CONFIG_FILE}"

if [ "${USE_JSON}" = "true" ]; then
cat >> "${CONFIG_FILE}" <<'EOF'
  // Pull the fields structured_metadata carries out of the JSON entry. The
  // line is the JSON until stage.output restores the MESSAGE at the end, so
  // every stage in between that reads content must say source = "message".
  stage.json {
    expressions = {
      message           = "MESSAGE",
      syslog_identifier = "SYSLOG_IDENTIFIER",
      container_name    = "CONTAINER_NAME",
      transport         = "_TRANSPORT",
      priority          = "PRIORITY",
    }
  }
EOF
fi

# level_from_message runs BEFORE structured_metadata, deliberately: the metadata
# stage removes a stream label of the same name when it moves that field into
# metadata, and the level stage needs the temporary container_name label to
# tell container streams apart. Found by the gate: with the order reversed the
# level was never corrected on the metadata path.
if [ "${LEVEL_FROM_MESSAGE}" = "true" ]; then
    # With the JSON path on, the line is the whole journal entry until the end
    # of the pipeline; the level must be read from the MESSAGE field, or a
    # level token in any other field (a command line, a tag) would be taken.
    LEVEL_SOURCE=""
    [ "${USE_JSON}" = "true" ] && LEVEL_SOURCE='      source     = "message"'
cat >> "${CONFIG_FILE}" <<EOF

  // Docker's journald driver logs a container's stderr at priority err, so a
  // WARN or INFO line written to stderr arrives as level="error". Scoped to
  // container streams at that priority; the level is re-derived from the
  // message (logfmt level=..., or a bare LEVEL token) and falls back to "error".
  stage.match {
    selector = "{level=\\"error\\", container_name=~\\".+\\"}"

    stage.regex {
${LEVEL_SOURCE}
      expression = "(?:^|\\\\s)level=(?P<logfmt_level>trace|debug|info|warn|warning|error|fatal|critical)(?:\\\\s|$)"
    }
    stage.regex {
${LEVEL_SOURCE}
      expression = "(?:^|\\\\s)(?P<bare_level>TRACE|DEBUG|INFO|WARN|WARNING|ERROR|FATAL|CRITICAL)(?:\\\\s|:)"
    }
EOF
cat >> "${CONFIG_FILE}" <<'EOF'
    stage.template {
      source   = "derived_level"
      template = "{{ if .logfmt_level }}{{ if eq .logfmt_level \"warn\" }}warning{{ else if eq .logfmt_level \"critical\" }}crit{{ else }}{{ .logfmt_level }}{{ end }}{{ else if .bare_level }}{{ if eq .bare_level \"TRACE\" }}trace{{ else if eq .bare_level \"DEBUG\" }}debug{{ else if eq .bare_level \"INFO\" }}info{{ else if eq .bare_level \"WARN\" }}warning{{ else if eq .bare_level \"WARNING\" }}warning{{ else if eq .bare_level \"ERROR\" }}error{{ else if eq .bare_level \"FATAL\" }}fatal{{ else if eq .bare_level \"CRITICAL\" }}crit{{ else }}error{{ end }}{{ else }}error{{ end }}"
    }
    stage.labels {
      values = {
        level = "derived_level",
      }
    }
  }
EOF
    drop=""
    has_label container_name || drop="${drop}\"container_name\", "
    has_label level          || drop="${drop}\"level\", "
    if [ -n "${drop}" ]; then
        printf '\n  // Temporary labels level_from_message needed, not chosen in stream_labels.\n  stage.label_drop {\n    values = [%s]\n  }\n' "${drop%, }" >> "${CONFIG_FILE}"
    fi
fi

if [ "${STRUCTURED_METADATA}" = "true" ]; then
    # One home per field: what is already a stream label is not also metadata.
    # stage.structured_metadata REMOVES a stream label of the same name when it
    # moves that field into metadata, so listing a chosen label here would
    # silently delete the label. (First seen as "syslog_identifier vanished".)
    sm=""
    for f in syslog_identifier container_name transport priority; do
        has_label "$f" || sm="${sm}      ${f} = \"\",\n"
    done
    if [ -n "${sm}" ]; then
        printf '\n  // Detail that is useful per line but poison as a stream label.\n  stage.structured_metadata {\n    values = {\n%b    }\n  }\n' "${sm}" >> "${CONFIG_FILE}"
    fi
fi

if [ "${USE_JSON}" = "true" ]; then
cat >> "${CONFIG_FILE}" <<'EOF'

  // The line itself is the journal MESSAGE again, not the JSON entry.
  stage.output {
    source = "message"
  }
EOF
fi
cat >> "${CONFIG_FILE}" <<EOF
  stage.drop {
    expression = "^\\\\s*$"
  }

  forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
  endpoint {
    url = "${LOKI_URL}"
  }
}
EOF

# ── Metrics: the one remote_write both scrapes feed ─────────────────────────
# Credentials never enter the config file: token and password are written to
# 0600 files and referenced, so the config stays readable without them. When
# nothing needs them the files are removed - a disabled feature leaves no
# credential on disk.
TOKEN_FILE="/data/metrics.token"
RW_PASSWORD_FILE="/data/remote_write.password"
# Alloy refuses a scrape_timeout above the interval, and `alloy validate` does
# not see that (a component build error: the service would crash-loop).
# Timeout = half the interval, capped at Alloy's 10s default.
timeout_for() {
    local n="${1%[smh]}" u="${1##*[0-9]}" t
    if [ "${u}" = "s" ] && [ "${n}" -le 20 ] 2>/dev/null; then
        t=$(( n / 2 )); [ "${t}" -lt 1 ] && t=1
        echo "${t}s"
    else
        echo "10s"
    fi
}
if [ "${METRICS_ENABLED}" = "true" ] || [ "${HOST_METRICS}" = "true" ]; then
    # The instance label on every metric. Neither the container nor Alloy knows
    # the Home Assistant OS hostname, so the default is the container's; set
    # metrics_instance to name the host.
    INSTANCE=$(optd metrics_instance "$(hostname)")
    METRICS_REMOTE_WRITE_URL=$(opt '.metrics_remote_write_url // ""')
    RW_USER=$(opt '.metrics_remote_write_user // ""')
    RW_PASSWORD=$(opt '.metrics_remote_write_password // ""')
    if [ -z "${METRICS_REMOTE_WRITE_URL}" ] || [ "${METRICS_REMOTE_WRITE_URL}" = "null" ]; then
        echo "!! metrics are on (metrics_enabled or host_metrics) but metrics_remote_write_url is empty - nowhere to send them."
        exit 1
    fi
    # Typed str in the schema so the form can show it empty; the check the url
    # type would have done happens here instead.
    case "${METRICS_REMOTE_WRITE_URL}" in http://*|https://*) ;; *) echo "!! metrics_remote_write_url must start with http:// or https://"; exit 1 ;; esac
    # Hosted Prometheus (Grafana Cloud and the like) wants basic auth on the
    # remote_write. Rendered only when a user is set.
    rw_auth=""
    if [ -n "${RW_USER}" ] && [ "${RW_USER}" != "null" ]; then
        (umask 077; printf '%s' "${RW_PASSWORD}" > "${RW_PASSWORD_FILE}")
        rw_auth="    basic_auth {
      username      = \"${RW_USER}\"
      password_file = \"${RW_PASSWORD_FILE}\"
    }"
    else
        rm -f "${RW_PASSWORD_FILE}"
    fi
    echo " remote_write: ${METRICS_REMOTE_WRITE_URL} (auth: $([ -n "${rw_auth}" ] && echo basic || echo none))"
    cat >> "${CONFIG_FILE}" <<EOF

// --- metrics go here ---
prometheus.remote_write "metrics" {
  endpoint {
    url = "${METRICS_REMOTE_WRITE_URL}"
${rw_auth}
  }
}
EOF
else
    rm -f "${RW_PASSWORD_FILE}"
fi

# ── Home Assistant metrics (metrics_enabled) ────────────────────────────────
# Scrapes an OpenMetrics endpoint - by default Home Assistant's own
# /api/prometheus, which needs `prometheus:` in configuration.yaml.
if [ "${METRICS_ENABLED}" = "true" ]; then
    METRICS_URL=$(optd metrics_url http://homeassistant:8123/api/prometheus)
    METRICS_TOKEN=$(opt '.metrics_token // ""')
    METRICS_INTERVAL=$(optd metrics_interval 60s)
    METRICS_JOB=$(optd metrics_job homeassistant)
    # Split the URL into what prometheus.scrape wants: scheme, host:port, path.
    scheme="${METRICS_URL%%://*}"
    rest="${METRICS_URL#*://}"
    hostport="${rest%%/*}"
    path="/${rest#*/}"; [ "${path}" = "/${rest}" ] && path="/metrics"
    case "${scheme}" in http|https) ;; *) echo "!! metrics_url must start with http:// or https://"; exit 1 ;; esac
    METRICS_TIMEOUT=$(timeout_for "${METRICS_INTERVAL}")
    auth=""
    if [ -n "${METRICS_TOKEN}" ] && [ "${METRICS_TOKEN}" != "null" ]; then
        # printf, not echo: a trailing newline would go out as "Bearer xxx\n".
        (umask 077; printf '%s' "${METRICS_TOKEN}" > "${TOKEN_FILE}")
        auth="  bearer_token_file = \"${TOKEN_FILE}\""
    else
        rm -f "${TOKEN_FILE}"
    fi
    echo " metrics: ${scheme}://${hostport}${path} every ${METRICS_INTERVAL} as job ${METRICS_JOB} (token: $([ -n "${auth}" ] && echo set || echo none))"
    cat >> "${CONFIG_FILE}" <<EOF

// --- Home Assistant metrics (metrics_enabled) ---
prometheus.scrape "metrics" {
  targets = [{
    __address__ = "${hostport}",
    instance    = "${INSTANCE}",
  }]
  scheme          = "${scheme}"
  metrics_path    = "${path}"
  job_name        = "${METRICS_JOB}"
  scrape_interval = "${METRICS_INTERVAL}"
  scrape_timeout  = "${METRICS_TIMEOUT}"
${auth}
  forward_to = [prometheus.remote_write.metrics.receiver]
}
EOF
else
    rm -f "${TOKEN_FILE}"
fi

# ── Host metrics (alloy-host variant only) ──────────────────────────────────
# What prometheus.exporter.unix can read from inside a container without host
# privileges: /proc/stat, meminfo, loadavg, diskstats, uptime, pressure and
# vmstat are kernel-global, and so are /sys/class/hwmon and thermal.
# Deliberately absent: netdev (would report this container's veth, not the
# host's NICs - a wrong number is worse than none), os (would say Debian, the
# image, not HA OS), systemd (needs the host's D-Bus). The filesystem
# collector sees only the mounts this add-on has, so it reports the data
# partition, not every host disk.
if [ "${HOST_METRICS}" = "true" ]; then
    HOST_JOB=$(optd host_metrics_job node)
    HOST_INTERVAL=$(optd host_metrics_interval 30s)
    echo " host metrics: every ${HOST_INTERVAL} as job ${HOST_JOB}"
    cat >> "${CONFIG_FILE}" <<EOF

// --- Host metrics (alloy-host) ---
prometheus.exporter.unix "host" {
  set_collectors = ["cpu", "meminfo", "loadavg", "diskstats", "filesystem", "hwmon", "thermal_zone", "uptime", "pressure", "vmstat"]
  filesystem {
    fs_types_exclude = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
  }
}

// The exporter's targets carry job="integrations/unix" and instance=<container
// id>, and a target's own labels win over job_name. Set both explicitly.
discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets
  rule {
    target_label = "job"
    replacement  = "${HOST_JOB}"
  }
  rule {
    target_label = "instance"
    replacement  = "${INSTANCE}"
  }
}

prometheus.scrape "host" {
  targets         = discovery.relabel.host.output
  job_name        = "${HOST_JOB}"
  scrape_interval = "${HOST_INTERVAL}"
  scrape_timeout  = "$(timeout_for "${HOST_INTERVAL}")"
  forward_to      = [prometheus.remote_write.metrics.receiver]
}
EOF
fi

if [ -n "${ADDITIONAL_CONFIG}" ] && [ "${ADDITIONAL_CONFIG}" != "null" ]; then
    printf '\n// --- Additional user config ---\n%s\n' "${ADDITIONAL_CONFIG}" >> "${CONFIG_FILE}"
fi

finish
